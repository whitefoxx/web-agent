{
  "manifest_version": 3,
  "name": "WebChat Agent",
  "version": "0.0.1",
  "description": "Turn any chat AI webpage (DeepSeek, ChatGPT, Gemini…) into a browser agent — zero API key, zero config.",
  "permissions": [
    "sidePanel",
    "debugger",
    "tabs",
    "scripting",
    "storage",
    "cookies",
    "downloads",
    "userScripts"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "action": {
    "default_title": "WebChat Agent"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "sandbox.html",
        "marketplace/index.json",
        "marketplace/*/*.js",
        "userscript-runner.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "minimum_chrome_version": "138"
}
