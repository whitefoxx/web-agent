node_modules
dist
.DS_Store
*.log
.env
.vite

# Local-only editor / tooling dirs. .claude/ holds machine-local Claude Code
# settings INCLUDING plaintext API tokens (settings.json.ds) — must never be
# committed. .chrometmp/ is the throwaway Chrome user-data dir from test runs
# (tens of MB). .vscode/ is per-machine editor prefs.
.claude/
.chrometmp/
.vscode/

# Captured DeepSeek HTML samples used as connector-selector references during
# development. Large (~6 MB total) and contain account-scoped DOM (sidebar
# avatars, recent-conversation titles, etc.) — keep out of source control.
deepseek-*.html

# RSA private key whose public half is manifest.json "key" (pins the extension
# ID to gcbgpkldpnmenoejbnbkdcagjhgbemeb). Only needed to re-derive the ID or
# sign a .crx outside the Web Store — never commit it.
extension-key.pem

# The two lean shells' dev-identity private keys. Their builds moved to the
# web-tools submodule (which ignores them itself); local copies may still sit
# here — never commit them.
extension-key-webcli.pem
extension-key-localmd.pem
