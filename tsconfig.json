{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["chrome", "node"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "allowJs": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@jackwener/opencli/registry": ["src/runtime/registry.js"],
      "@jackwener/opencli/errors": ["src/runtime/errors.js"],
      "@jackwener/opencli/utils": ["src/runtime/opencli/utils.ts"],
      "@jackwener/opencli/logger": ["src/runtime/opencli/logger.ts"],
      "@jackwener/opencli/types": ["src/runtime/opencli/types.ts"]
    }
  },
  "include": ["src"]
}
